# Vorlage fuer .env - diese Datei gehoert ins Repository.
# Kopieren:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Danach die Platzhalter durch echte Werte ersetzen.
#
# Die echte .env ist gitignored und darf NIE committet werden.

# --- PostgreSQL ---
POSTGRES_USER=devboard
POSTGRES_PASSWORD=changeme
POSTGRES_DB=devboard

# --- Backend ---
# NODE_ENV: development | test | production
NODE_ENV=development
PORT=3000

# Welche Herkunft darf das Backend im Browser aufrufen (Frontend-URL)?
# Mehrere durch Komma trennen. Niemals "*" verwenden.
CORS_ORIGIN=http://localhost:3001

# Signiergeheimnis fuer JWTs, mindestens 32 Zeichen.
# Eigenen Wert erzeugen, NIEMALS diesen Platzhalter verwenden:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=hier-ein-eigenes-geheimnis-mit-mindestens-32-zeichen
# Lebensdauer des Access-Tokens (z. B. 15m, 1h). Kurz halten.
JWT_ACCESS_TTL=15m
# Lebensdauer des Refresh-Tokens in Tagen.
REFRESH_TTL_DAYS=30

# --- Rate Limiting ---
# Zeitfenster in Sekunden und erlaubte Anfragen darin.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Deutlich strenger fuer Anmelden und Registrieren - dort werden Passwoerter
# durchprobiert.
AUTH_THROTTLE_LIMIT=10

# Muss zu POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB oben passen.
# Host "localhost", wenn das Backend direkt auf dem Rechner laeuft.
# Host "db" (Service-Name), sobald es selbst im Container laeuft.
DATABASE_URL=postgresql://devboard:changeme@localhost:5432/devboard?schema=public
