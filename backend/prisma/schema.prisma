// Datenmodell von DevBoard.
// Aenderungen hier erzeugen per `npm run db:migrate` eine versionierte
// SQL-Migration unter prisma/migrations/.

generator client {
  provider = "prisma-client"

  // Der Client wird als TypeScript erzeugt und muss mitkompiliert werden.
  // Deshalb liegt er unter src/ - alles ausserhalb landet nicht in dist/.
  output = "../src/generated/prisma"

  // NestJS kompiliert nach CommonJS. Ohne diese Zeile erzeugt Prisma 7 ESM
  // mit `import.meta`, woran sowohl Jest als auch der Node-Start scheitern.
  moduleFormat = "cjs"

  // Ohne diese Zeile schreibt Prisma ".js" an interne Importe (ESM-Stil).
  // Jest kann das im CommonJS-Modus nicht aufloesen.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
  // Die URL kommt aus prisma.config.ts (Prisma 7), nicht mehr aus dieser Datei.
}

/// Ein Benutzerkonto.
model User {
  id    String  @id @default(uuid()) @db.Uuid
  /// Immer kleingeschrieben gespeichert - siehe AuthService.
  /// Sonst waeren "Max@example.com" und "max@example.com" zwei Konten.
  email String  @unique
  name  String?

  /// NIE das Passwort selbst, immer nur der argon2-Hash.
  /// Der Name sagt das ausdruecklich - "password" waere eine Einladung zum Fehler.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  memberships   Membership[]
  /// Einladungen, die dieser Nutzer AUSGESPROCHEN hat - nicht die an ihn
  /// gerichteten. Letztere haengen an einer E-Mail-Adresse, nicht an einem
  /// Konto, weil es das Konto beim Einladen noch nicht geben muss.
  sentInvitations Invitation[]

  @@map("users")
}

/// Rolle eines Nutzers INNERHALB einer Organisation.
///
/// Warum ein Enum und nicht einfach ein Text-Feld? Die Datenbank erzwingt die
/// gueltigen Werte selbst - ein Tippfehler wie "Admn" kommt gar nicht erst
/// hinein, und Prisma erzeugt daraus einen TypeScript-Union-Typ. Bei Text
/// haette man beides nicht und muesste sich auf Anwendungscode verlassen.
///
/// Der Preis: Ein neuer Wert braucht eine Migration, und Werte zu entfernen
/// oder umzusortieren ist in PostgreSQL umstaendlich. Bei einer Rollenliste,
/// die sich alle paar Jahre aendert, ist das der richtige Tausch. Bei etwas
/// Volatilem (frei definierbare Task-Status) waere Text mit Referenztabelle
/// die bessere Wahl.
///
/// Die Reihenfolge ist absteigend nach Rechten - so gelesen ist sie leichter
/// zu merken. Verlassen darf sich der Code darauf NICHT: Ein Vergleich wie
/// `rolle <= Role.ADMIN` waere ein Zahlenvergleich auf einem Enum und bricht,
/// sobald jemand einen Wert dazwischen einfuegt.
enum Role {
  OWNER
  ADMIN
  MEMBER

  @@map("role")
}

/// Ein Mandant. Alles fachliche Datum ab Sprint 3 (Projekte, Tasks) haengt
/// an genau einer Organisation - sie ist die Grenze, an der Sichtbarkeit endet.
model Organization {
  id   String @id @default(uuid()) @db.Uuid
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]

  @@map("organizations")
}

/// Eine ausgesprochene Einladung in eine Organisation.
///
/// ============================================================================
/// WARUM DIE EINLADUNG AN EINE ADRESSE GEHT UND NICHT AN EINEN NUTZER
/// ============================================================================
/// Zum Zeitpunkt der Einladung gibt es das Konto moeglicherweise noch gar
/// nicht - das ist der Normalfall bei einem neuen Kollegen. Ein
/// Fremdschluessel auf `users` waere also nicht setzbar.
///
/// Der zweite, wichtigere Grund: Wuerde beim Einladen nachgeschlagen, ob es
/// den Nutzer gibt, waeren die beiden Faelle von aussen unterscheidbar - und
/// jeder ADMIN haette einen Dienst, mit dem er pruefen kann, wer bei DevBoard
/// ein Konto hat. Die Adresse als Text zu speichern haelt beide Faelle gleich.
model Invitation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Immer kleingeschrieben - dieselbe Normalisierung wie bei `users.email`.
  /// Sonst wuerde eine Einladung an "Max@example.com" nicht zum Konto
  /// "max@example.com" passen, obwohl es dieselbe Adresse ist.
  email String

  /// Nur ADMIN oder MEMBER. OWNER wird NIE per Einladung vergeben, sondern
  /// ausschliesslich durch Ernennen eines bestehenden Mitglieds - sonst
  /// koennte ein ADMIN ueber den Umweg der Einladung Rechte vergeben, die er
  /// selbst nicht hat. Erzwungen wird das im Zod-Schema, nicht hier: Das Enum
  /// ist dasselbe wie bei der Mitgliedschaft, und eine eigene Kopie mit zwei
  /// Werten waere eine zweite Wahrheit.
  role Role

  /// NIE der Token selbst, sondern sein SHA-256-Hash - dasselbe Prinzip wie
  /// bei den Refresh-Token. Bei einem Datenbankleck waeren gespeicherte
  /// Rohwerte sofort verwendbare Zugaenge zu fremden Organisationen.
  ///
  /// SHA-256 statt argon2, weil der Token aus 256 Bit Zufall besteht und kein
  /// erratbares Passwort ist - gegen Durchprobieren muss nichts gebremst
  /// werden.
  tokenHash String @unique

  /// Wer eingeladen hat. Nur zur Nachvollziehbarkeit in der Mitgliederliste.
  ///
  /// SetNull statt Cascade: Verlaesst der Einladende das Unternehmen und sein
  /// Konto wird geloescht, soll die Einladung nicht mitverschwinden - sie ist
  /// bereits verschickt und jemand wartet darauf. Die Herkunftsangabe geht
  /// verloren, die Einladung bleibt gueltig.
  invitedById String? @db.Uuid
  invitedBy   User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt DateTime

  /// Gesetzt, sobald die Einladung eingeloest wurde. Die Zeile wird NICHT
  /// geloescht: Nur so laesst sich eine zweite Einlosung desselben Tokens
  /// als solche erkennen, statt sie von einer erfundenen zu nicht
  /// unterscheiden - dasselbe Argument wie bei den Refresh-Token.
  acceptedAt DateTime?

  /// Gesetzt, wenn zurueckgezogen oder durch eine neuere Einladung an
  /// dieselbe Adresse ersetzt.
  revokedAt DateTime?

  createdAt DateTime @default(now())

  /// Fuer "alle offenen Einladungen dieser Organisation" (Verwaltungsansicht)
  /// und fuer das Entwerten aelterer Einladungen an dieselbe Adresse.
  ///
  /// KEIN UNIQUE: Sauber waere ein PARTIELLER Unique-Index ueber
  /// (organizationId, email) WHERE acceptedAt IS NULL AND revokedAt IS NULL -
  /// also "hoechstens eine OFFENE Einladung je Adresse". Genau das kann Prisma
  /// nicht deklarieren. Ein voller Unique-Index waere falsch: Er wuerde eine
  /// zweite Einladung nach Ablauf der ersten verhindern. Durchgesetzt wird die
  /// Regel deshalb im Service; der Index ist in 06_BACKLOG.md vermerkt.
  @@index([organizationId, email])
  @@map("invitations")
}

/// Die Zugehoerigkeit eines Nutzers zu einer Organisation - MIT seiner Rolle.
///
/// ============================================================================
/// WARUM EIN EIGENES MODELL UND KEINE REINE N:M-BEZIEHUNG
/// ============================================================================
/// Prisma kann n:m implizit abbilden (`users User[]` auf beiden Seiten), dann
/// erzeugt es im Hintergrund eine Verbindungstabelle mit genau zwei Spalten.
/// Das reicht hier nicht: Die Rolle gehoert weder an den Nutzer noch an die
/// Organisation.
///
/// Ein Nutzer ist OWNER in seiner eigenen Organisation und MEMBER in der eines
/// Kunden - dieselbe Person, dieselbe Organisation, unterschiedliche Rolle.
/// Die Rolle ist also eine Eigenschaft der BEZIEHUNG. Sobald eine Verbindung
/// eigene Attribute traegt, wird sie zu einer eigenen Entitaet.
model Membership {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  /// Cascade: Wird eine Organisation geloescht, verschwinden ihre
  /// Mitgliedschaften. Eine Mitgliedschaft ohne Organisation ergibt keinen Sinn.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ==========================================================================
  /// WARUM DIE EINDEUTIGKEIT IN DER DATENBANK STEHT
  /// ==========================================================================
  /// Ein Nutzer darf in derselben Organisation nur EINE Mitgliedschaft haben -
  /// sonst waere seine Rolle nicht mehr eindeutig bestimmbar.
  ///
  /// Eine Pruefung im Code ("ist der schon Mitglied?") hat immer eine Luecke
  /// zwischen Lesen und Schreiben. Zwei gleichzeitig angenommene Einladungen
  /// koennten beide durchkommen. Ein UNIQUE-Constraint kann das nicht -
  /// dasselbe Argument wie bei `users.email`.
  @@unique([organizationId, userId])
  /// ==========================================================================
  /// WARUM userId TROTZDEM NOCH EINMAL EINZELN INDIZIERT IST
  /// ==========================================================================
  /// Der Unique-Index oben ist ein Baum, sortiert ERST nach organizationId,
  /// DANN nach userId. Eine Abfrage nach organizationId allein kann ihn nutzen
  /// (Praefix-Regel), eine Abfrage nach userId allein NICHT - diese Werte
  /// liegen ueber den gesamten Index verstreut.
  ///
  /// `GET /organizations` ("meine Organisationen") fragt aber genau nach
  /// userId. Ohne diesen zweiten Index muesste PostgreSQL bei jedem
  /// Seitenaufruf die ganze Tabelle lesen.
  ///
  /// Merksatz: Ein zusammengesetzter Index hilft nur von LINKS gelesen.
  @@index([userId])
  @@map("memberships")
}

/// Ein ausgestellter Refresh-Token.
///
/// Anders als der Access-Token wird dieser SERVERSEITIG gespeichert - nur
/// deshalb ist er widerrufbar, und nur deshalb wirkt ein Logout wirklich.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  /// NIE der Token selbst, sondern sein SHA-256-Hash.
  /// Bei einem Datenbankleck sind die gespeicherten Werte damit wertlos -
  /// dasselbe Prinzip wie bei Passwoertern.
  ///
  /// Warum hier SHA-256 und nicht argon2? Weil dieser Token bereits 256 Bit
  /// Zufall enthaelt und kein erratbares Passwort ist. Gegen Durchprobieren
  /// muss nichts gebremst werden; Geschwindigkeit ist hier sogar erwuenscht,
  /// weil bei jedem Erneuern geprueft wird.
  tokenHash String @unique

  /// Alle Token, die durch Rotation auseinander hervorgegangen sind, teilen
  /// sich diese Kennung. Wird ein bereits verbrauchter Token noch einmal
  /// vorgelegt, gilt die gesamte FAMILIE als kompromittiert und wird
  /// widerrufen - siehe RefreshTokenService.
  familyId String @db.Uuid

  userId String @db.Uuid
  /// onDelete: Cascade - wird ein Konto geloescht, verschwinden auch seine
  /// Token. Sonst blieben verwaiste Zeilen zurueck, die auf nichts zeigen.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// Gesetzt, sobald der Token verbraucht oder widerrufen wurde.
  /// Die Zeile wird NICHT geloescht - nur ein aufbewahrter, entwerteter Token
  /// erlaubt es, seine Wiederverwendung ueberhaupt zu bemerken.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  /// Index auf userId: fuer "alle Sitzungen dieses Nutzers beenden".
  /// Index auf familyId: fuer das Widerrufen einer ganzen Familie.
  /// Ohne beide muesste PostgreSQL die Tabelle jedes Mal vollstaendig lesen.
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
