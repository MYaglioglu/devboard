# =============================================================================
# DevBoard - Reverse Proxy (Vorlage)
# =============================================================================
#
# Die echte Datei heisst `.env.proxy`, liegt nur auf dem Server und wird von
# .gitignore erfasst.
#
#   cp .env.proxy.example .env.proxy
#   nano .env.proxy
#
# Hier stehen KEINE Geheimnisse - Domainnamen sind oeffentlich, und die
# E-Mail-Adresse steht ohnehin im Zertifikatsantrag. Die Datei ist trotzdem
# getrennt von den Anwendungs-Umgebungen: Der Proxy soll die Datenbank-URLs
# und Signierschluessel gar nicht erst lesen koennen.
# =============================================================================

# Kontaktadresse fuer Let's Encrypt. Dorthin geht die Warnung, wenn eine
# Zertifikatserneuerung scheitert.
ACME_EMAIL=deine@mailadresse.de

# Produktion. Der A-Eintrag muss auf diesen Server zeigen, BEVOR der Proxy
# startet - sonst scheitert die Zertifikatsanforderung.
API_DOMAIN=api.devboard.info

# Staging. Braucht einen EIGENEN A-Eintrag auf dieselbe IP-Adresse.
STAGING_DOMAIN=staging-api.devboard.info
